# Template cho apps/backend/.env.staging - COPY sang .env.staging rồi điền giá trị THẬT, MỚI.
# KHÔNG commit .env.staging (đã có trong .gitignore). KHÔNG dùng lại bất kỳ secret/DB nào của
# pshop-music hay production - mọi giá trị dưới đây phải là giá trị MỚI, riêng cho staging.

NODE_ENV=staging
PORT=3000

# Phải khớp với STAGING_DB_USER/STAGING_DB_PASSWORD/STAGING_DB_NAME dùng để chạy
# docker-compose.staging.yml (đặt các biến đó trong shell hoặc file .env cùng cấp khi chạy
# `docker compose -f docker-compose.staging.yml up`). Host là tên service "postgres" (DNS nội bộ
# Docker Compose) - KHÔNG phải localhost.
DATABASE_URL=postgresql://viecnhatrang:CHANGE-ME-NEW-PASSWORD@postgres:5432/viec_nha_trang_staging?schema=public

# Sinh mới, KHÔNG copy từ .env development hay production. Ví dụ sinh nhanh:
#   openssl rand -base64 48
JWT_ACCESS_SECRET=CHANGE-ME-GENERATE-NEW-RANDOM-SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE-ME-GENERATE-NEW-RANDOM-SECRET
JWT_REFRESH_EXPIRES_IN=30d

SMS_PROVIDER=console
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_THROTTLE_LIMIT=3
OTP_VERIFY_THROTTLE_LIMIT=5

THROTTLE_TTL=60
THROTTLE_LIMIT=60

# Để trống - push/storage tự động no-op an toàn (xem lib/shared/services/push_service.dart và
# docs/MOBILE.md). Không dùng project Firebase/storage của pshop-music.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
FCM_SERVICE_ACCOUNT_FILE=
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
