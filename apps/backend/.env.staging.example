# Template cho apps/backend/.env.staging - COPY sang .env.staging rồi điền giá trị THẬT, MỚI.
# KHÔNG commit .env.staging (đã có trong .gitignore). KHÔNG dùng lại bất kỳ secret/DB nào của
# pshop-music hay production - mọi giá trị dưới đây phải là giá trị MỚI, riêng cho staging.

NODE_ENV=staging
PORT=3000

# KHÔNG đặt DATABASE_URL ở đây - docker-compose.staging.yml tự ghép DATABASE_URL cho container
# backend từ STAGING_DB_USER/STAGING_DB_PASSWORD/STAGING_DB_NAME trong
# docker-compose.staging.env (xem file đó + docker-compose.staging.env.example). Giữ mật khẩu DB
# ở đúng MỘT nơi, tránh 2 file lệch nhau.

# Sinh mới, KHÔNG copy từ .env development hay production. Ví dụ sinh nhanh:
#   openssl rand -base64 48
JWT_ACCESS_SECRET=CHANGE-ME-GENERATE-NEW-RANDOM-SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE-ME-GENERATE-NEW-RANDOM-SECRET
JWT_REFRESH_EXPIRES_IN=30d

# Staging PHẢI dùng "esms" để test OTP thật (đặc tả yêu cầu SMS thật, không phải console log) -
# xem src/auth/sms-provider.factory.ts. Đặt lại "console" chỉ khi cố tình muốn tắt gửi SMS thật.
SMS_PROVIDER=esms
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_THROTTLE_LIMIT=3
OTP_VERIFY_THROTTLE_LIMIT=5

# Chỉ cần khi SMS_PROVIDER=esms (đang là mặc định ở staging) - lấy từ https://esms.vn sau khi
# đăng ký tài khoản. Sinh/điền THẬT trên server, KHÔNG commit - đây chỉ là placeholder.
ESMS_API_KEY=CHANGE-ME-ESMS-API-KEY
ESMS_SECRET_KEY=CHANGE-ME-ESMS-SECRET-KEY
# Để trống nếu chưa có Brandname được eSMS duyệt.
ESMS_BRANDNAME=

THROTTLE_TTL=60
THROTTLE_LIMIT=60

# Để trống - push/storage tự động no-op an toàn (xem lib/shared/services/push_service.dart và
# docs/MOBILE.md). Không dùng project Firebase/storage của pshop-music.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
FCM_SERVICE_ACCOUNT_FILE=
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
