# Environment: development | staging | production
NODE_ENV=development
PORT=3000

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/viec_nha_trang?schema=public"

JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d

# OTP / SMS provider (pluggable, not hard-coded to one vendor)
SMS_PROVIDER=console
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# Push notifications
FCM_SERVER_KEY=

# Object storage (S3-compatible)
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=60
