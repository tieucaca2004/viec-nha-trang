# Environment: development | staging | production
NODE_ENV=development
PORT=3000

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/viec_nha_trang?schema=public"
# Dùng riêng cho `npm run test:e2e` (apps/backend/.env.test) - KHÔNG trỏ vào DB development/production.
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/viec_nha_trang_test?schema=public"

JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d

# OTP / SMS provider (pluggable, not hard-coded to one vendor).
# SMS_PROVIDER=console (mặc định, dev) -> chỉ log OTP ra console, không gửi SMS thật.
# SMS_PROVIDER=esms -> gửi SMS thật qua eSMS.vn (staging/production), cần điền 3 biến ESMS_* bên
# dưới. Giá trị khác "console"/"esms" sẽ làm app FAIL FAST lúc khởi động (xem
# src/auth/sms-provider.factory.ts).
SMS_PROVIDER=console
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# Chỉ cần điền khi SMS_PROVIDER=esms - lấy từ https://esms.vn (mục "Thông tin cấu hình" sau khi
# đăng ký tài khoản). KHÔNG commit giá trị thật - đây chỉ là placeholder.
ESMS_API_KEY=
ESMS_SECRET_KEY=
# Brandname đã đăng ký & được eSMS duyệt - để trống nếu chưa có Brandname (vẫn gửi được, chỉ
# không hiện tên thương hiệu cho người nhận).
ESMS_BRANDNAME=

# Push notifications (Firebase Cloud Messaging - project RIÊNG "viec-nha-trang",
# KHÔNG dùng chung với pshop-music). Để trống cả 2 -> push tự động no-op (log cảnh báo, không lỗi).
FCM_PROJECT_ID=
# Nội dung JSON service account (ưu tiên dùng ở production/Secret Manager)
FCM_SERVICE_ACCOUNT_JSON=
# HOẶC đường dẫn tới file service account (tiện cho dev local)
FCM_SERVICE_ACCOUNT_FILE=

# Object storage (S3-compatible)
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=60
# Giới hạn riêng cho OTP (mặc định 3/5 lần mỗi phút mỗi IP - mục 35 chống spam).
# .env.test nới các giá trị này vì e2e test gọi OTP liên tiếp từ cùng 1 IP.
OTP_REQUEST_THROTTLE_LIMIT=3
OTP_VERIFY_THROTTLE_LIMIT=5

# Email verification - dùng để ĐĂNG KÝ tài khoản (không dùng SMS OTP ở bước này nữa).
# EMAIL_PROVIDER=console (mặc định, dev) -> chỉ log mã ra console, không gửi email thật.
# EMAIL_PROVIDER=smtp -> gửi email thật qua SMTP tự cấu hình (không khoá cứng vào 1 nhà cung cấp
# trả phí cụ thể - điền đủ SMTP_HOST/SMTP_USER/SMTP_PASS bên dưới, có thể dùng SMTP miễn phí tự
# host hoặc Gmail App Password cho dev/thử nghiệm). Giá trị khác "console"/"smtp" sẽ làm app FAIL
# FAST lúc khởi động (xem src/auth/email-provider.factory.ts).
EMAIL_PROVIDER=console
EMAIL_VERIFICATION_TTL_SECONDS=600
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_REQUEST_THROTTLE_LIMIT=3
EMAIL_VERIFICATION_VERIFY_THROTTLE_LIMIT=5

# Chỉ cần điền khi EMAIL_PROVIDER=smtp. KHÔNG commit giá trị thật - đây chỉ là placeholder.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@viecnhatrang.local
