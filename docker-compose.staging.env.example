# Template cho docker-compose.staging.env - biến dùng để NỘI SUY (interpolation) vào
# docker-compose.staging.yml, KHÔNG phải biến app đọc trực tiếp (đó là apps/backend/.env.staging).
#
# COPY sang docker-compose.staging.env (đã gitignore) rồi điền mật khẩu THẬT, MỚI - KHÔNG dùng
# lại bất kỳ mật khẩu nào của pshop-music/production. Không export biến này trong shell (tránh
# lưu vào lịch sử shell) - truyền vào Compose bằng cờ `--env-file docker-compose.staging.env`
# (deploy-staging.sh đã làm việc này giúp bạn).
#
# Đây là NGUỒN DUY NHẤT cho user/password/tên DB staging - docker-compose.staging.yml tự ghép
# thành DATABASE_URL cho backend (xem service "backend" trong file đó), nên bạn KHÔNG cần và
# KHÔNG nên đặt DATABASE_URL riêng trong apps/backend/.env.staging - tránh 2 nơi có thể lệch nhau.
STAGING_DB_USER=viecnhatrang
STAGING_DB_PASSWORD=CHANGE-ME-GENERATE-NEW-RANDOM-PASSWORD
STAGING_DB_NAME=viec_nha_trang_staging
